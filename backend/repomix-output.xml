// Helper for Excel dates
const formatExcelDate = (dateStr) => {
    if (!dateStr || dateStr === 'NULL') return null;
    const parts = dateStr.split('/');
    if (parts.length === 3) {
        const month = parts[0].padStart(2, '0');
        const day = parts[1].padStart(2, '0');
        const year = parts[2];
        return `${year}-${month}-${day}`;
    }
    return dateStr;
};

