// --- UPGRADED SMS HELPER WITH LOGGING ---
const sendSMS = async (phone, text) => {
    let status = 'SIMULATED';
    let error = null;

    try {
        const [params] = await db.promise().execute("SELECT param_key, param_value FROM system_parameters WHERE category = 'SMS'");
        const isLive = params.find(p => p.param_key === 'sms_enabled')?.param_value === '1';
        
        if (isLive) {
            const config = {
                url: params.find(p => p.param_key === 'sms_gateway_url').param_value,
                user: params.find(p => p.param_key === 'sms_username').param_value,
                pass: params.find(p => p.param_key === 'sms_password').param_value,
                from: params.find(p => p.param_key === 'sms_sender_id').param_value
            };
            const fullUrl = `${config.url}?username=${config.user}&password=${config.pass}&from=${config.from}&to=${phone}&text=${encodeURIComponent(text)}`;
            await axios.get(fullUrl);
            status = 'SENT';
        }

        // Always log for Audit
        await db.promise().execute("INSERT INTO sms_logs (recipient_phone, message_text, status) VALUES (?, ?, ?)", [phone, text, status]);
        return { success: true, status };
    } catch (err) {
        await db.promise().execute("INSERT INTO sms_logs (recipient_phone, message_text, status, error_log) VALUES (?, ?, 'FAILED', ?)", [phone, text, err.message]);
        return { success: false, error: err.message };
    }
};

